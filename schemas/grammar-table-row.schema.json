{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manabi.io/schemas/grammar-table-row.schema.json",
  "title": "Manabi Grammar Content Row (generated by schema_contract.py)",
  "type": "object",
  "required": [
    "examples",
    "ruleID",
    "ruleVersion",
    "targetLanguage",
    "headword",
    "variant",
    "info"
  ],
  "properties": {
    "jmdictId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "alternativeForms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Optional list of alternative representations of the headword."
    },
    "examples": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://[^\\s/?#@]+(?:[/?#][^\\s]*)?$",
        "allOf": [
          {
            "pattern": "#text="
          }
        ]
      }
    },
    "exampleSentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sentence"
        ],
        "properties": {
          "sentence": {
            "type": "string",
            "minLength": 1
          },
          "translations": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
            }
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://[^\\s/?#@]+(?:[/?#][^\\s]*)?$"
          }
        },
        "additionalProperties": false
      },
      "description": "Example sentences tied to the grammar point with optional translations and sourcing."
    },
    "variant": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Distinct variant identifier for grammar entries sharing the same headword.",
      "maximum": 2147483647
    },
    "ruleID": {
      "type": "string",
      "pattern": "^grammar\\.[a-z]{2,3}\\.[a-z0-9][a-z0-9.-]*$"
    },
    "ruleVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "headword": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "targetLanguage": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "levelLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "info": {
      "$ref": "#/$defs/info"
    },
    "referenceBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referenceBinding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "url",
        "name"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s/?#@]+(?:[/?#][^\\s]*)?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "recommended": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "referenceBinding": {
      "type": "object",
      "required": [
        "ruleVersion",
        "readerLanguage",
        "references"
      ],
      "properties": {
        "ruleVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "readerLanguage": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+:[a-z0-9._-]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "info": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "Meaning": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "Guides": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/resource"
            }
          },
          "Q&A": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/resource"
            }
          },
          "Related": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/resource"
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
